# Panel password (required).
APP_PASSWORD=change-me

# Session signing key. Empty = generated automatically and stored in the volume.
SESSION_SECRET=

# Database password (internal, not exposed).
POSTGRES_PASSWORD=findhub

# Site address for Caddy:
#   :80                  -> plain HTTP (LAN / behind another reverse proxy)
#   findhub.example.com  -> automatic HTTPS (Let's Encrypt); then set HTTP_PORT=80 and HTTPS_PORT=443
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# How often to poll devices, in seconds (min. 60). BT tags report rarely; 300 is a reasonable compromise.
POLL_INTERVAL_SECONDS=300
# Pause between devices within one cycle (Google rate limits).
DEVICE_DELAY_SECONDS=5
# How long to wait for a location response (it arrives via FCM push).
LOCATE_TIMEOUT_SECONDS=60
# How many days of history to keep (0 = no limit).
RETENTION_DAYS=0

# Language of the Google sign-in page in the Chrome container.
CHROME_LANG=en
TZ=Europe/Warsaw
