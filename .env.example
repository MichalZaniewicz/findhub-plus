# Hasło do panelu (wymagane).
APP_PASSWORD=zmien-mnie

# Klucz do podpisywania sesji. Puste = wygenerowany automatycznie i zapisany w wolumenie.
SESSION_SECRET=

# Hasło bazy danych (wewnętrzne, nie wystawiane na zewnątrz).
POSTGRES_PASSWORD=findhub

# Adres strony dla Caddy:
#   :80                   -> zwykłe HTTP (LAN / za innym reverse proxy)
#   findhub.twojadomena.pl -> automatyczny HTTPS (Let's Encrypt); wtedy ustaw HTTP_PORT=80 i HTTPS_PORT=443
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Co ile sekund odpytywać urządzenia (min. 60). Tagi BT raportują rzadko, 300 to rozsądny kompromis.
POLL_INTERVAL_SECONDS=300
# Przerwa między kolejnymi urządzeniami w jednym cyklu (limity Google).
DEVICE_DELAY_SECONDS=5
# Ile czekać na odpowiedź z lokalizacją (przychodzi przez FCM push).
LOCATE_TIMEOUT_SECONDS=60
# Ile dni trzymać historię (0 = bez limitu).
RETENTION_DAYS=0

# Język strony logowania Google w kontenerze z Chrome.
CHROME_LANG=pl
TZ=Europe/Warsaw
