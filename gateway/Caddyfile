{$SITE_ADDRESS::80} {
	encode gzip

	# Chrome view from the login container - only for users logged in to the panel.
	handle /novnc/* {
		forward_auth {$APP_UPSTREAM:app:8000} {
			uri /api/auth/verify
			# Without this, the auth subrequest for the WebSocket (noVNC) reaches app as an upgrade -> 403.
			header_up -Connection
			header_up -Upgrade
		}
		uri strip_prefix /novnc
		reverse_proxy {$LOGIN_UPSTREAM:login:7900}
	}

	handle {
		reverse_proxy {$APP_UPSTREAM:app:8000}
	}
}
